# Copy this file to .env and fill in real values before running in production.
# If DB_NAME is unset, SQLite is used automatically (great for quick local demos).

SECRET_KEY=dev-only-change-me-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (leave these unset to use SQLite)
DB_NAME=medislot
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
